{
  "name": "chaoxing-course-archive",
  "version": "0.1.0-alpha.11",
  "private": true,
  "type": "module",
  "description": "Local Chaoxing replay transcript and slide archive",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "course-archive": "src/run.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "start": "node src/run.mjs"
  },
  "overrides": {
    "image-size": "2.1.0"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "playwright-core": "1.65.1",
    "pptxgenjs": "4.0.0",
    "sharp": "0.35.5",
    "video-slide-extractor": "0.3.1"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  }
}
