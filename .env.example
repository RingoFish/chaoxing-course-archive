# Copy to .env for local use. Never commit the filled .env.
COURSE_ACCOUNT=
COURSE_PASSWORD=
# Leave -1 to use the account's default institution. Set the school's ID if the default is wrong.
COURSE_FID=-1
# Optional. Leave blank for the standard authenticated course list.
COURSE_ENTRY_URL=
# Local subscriptions only. GitHub Actions reads data/subscriptions.json from your own data branch.
COURSE_IDS=

# none / email / qq / both
DELIVERY=none
# Set false for the first interactive browser login; true reuses the saved profile.
COURSE_HEADLESS=true

# QQ Mail example. SMTP_PASSWORD is an SMTP authorization code, not web password.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_EMAIL=
SMTP_PASSWORD=
RECEIVER_EMAIL=
MAIL_FROM=
MAIL_MAX_RAW_MB=18
# Optional independent encryption key. Keep it stable when changing login password.
STATE_KEY=

# Optional local OneBot/NapCat private file delivery.
QQ_API_URL=
QQ_API_TOKEN=
QQ_TARGET_USER_ID=
# Optional path to output directory as seen by the QQ service.
QQ_FILE_ROOT=
